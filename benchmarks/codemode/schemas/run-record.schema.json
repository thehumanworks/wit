{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehumanworks.github.io/wit/benchmarks/codemode/run-record.schema.json",
  "title": "wit Code Mode benchmark run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "benchmark_kind", "run_id", "pair_id", "corpus_id",
    "corpus_sha256", "thresholds_sha256", "implementation", "task_id",
    "mode", "repetition", "model", "cache", "environment", "status",
    "metrics", "raw", "grading", "response"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "benchmark_kind": {"enum": ["model_evaluation", "deterministic_contract"]},
    "run_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thresholds_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["git_commit", "wit_mcp_sha256", "worker_sha256"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "wit_mcp_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "worker_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "task_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["direct", "code"]},
    "repetition": {"type": "integer", "minimum": 1},
    "model": {"$ref": "#/$defs/model"},
    "cache": {"$ref": "#/$defs/cache"},
    "environment": {"$ref": "#/$defs/environment"},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "error_code": {"type": ["string", "null"]},
    "metrics": {"$ref": "#/$defs/metrics"},
    "raw": {"$ref": "#/$defs/raw"},
    "grading": {"$ref": "#/$defs/grading"},
    "response": {"$ref": "#/$defs/response"}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id", "version", "temperature"],
      "properties": {
        "provider": {"type": "string"}, "id": {"type": "string"},
        "version": {"type": "string"}, "temperature": {"type": "number"}
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "reset_between_modes", "reset_between_repetitions", "repository_network", "model_api_network", "repository_source", "cache_root_lifecycle"],
      "properties": {
        "initial_state": {"type": "string"}, "reset_between_modes": {"type": "boolean"},
        "reset_between_repetitions": {"type": "boolean"}, "repository_network": {"type": "string"},
        "model_api_network": {"type": "string"}, "repository_source": {"type": "string"},
        "cache_root_lifecycle": {"type": "string"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "machine", "python", "git", "tiktoken", "jsonschema", "locale", "timezone", "commands", "fixture_refs", "mcp_startup_ms"],
      "properties": {
        "platform": {"type": "string"}, "machine": {"type": "string"},
        "python": {"type": "string"}, "git": {"type": "string"},
        "tiktoken": {"type": "string"}, "jsonschema": {"type": "string"},
        "locale": {"type": "string"}, "timezone": {"type": "string"},
        "commands": {"type": "object"},
        "fixture_refs": {
          "type": "object", "additionalProperties": false,
          "required": ["base", "target"],
          "properties": {"base": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "target": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
        },
        "mcp_startup_ms": {"type": "number", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_description_bytes", "tool_description_tokens", "model_visible_input_bytes",
        "model_visible_result_bytes", "model_cached_input_tokens", "outer_mcp_calls", "inner_host_calls", "invalid_calls",
        "wall_time_ms", "worker_startup_ms", "peak_rss_bytes", "peak_cpu_percent", "peak_process_count"
      ],
      "properties": {
        "tool_description_bytes": {"type": "integer", "minimum": 0},
        "tool_description_tokens": {"type": "integer", "minimum": 0},
        "model_visible_input_bytes": {"type": "integer", "minimum": 0},
        "model_visible_result_bytes": {"type": "integer", "minimum": 0},
        "model_cached_input_tokens": {"type": "integer", "minimum": 0},
        "outer_mcp_calls": {"type": "integer", "minimum": 0},
        "inner_host_calls": {"type": "integer", "minimum": 0},
        "invalid_calls": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "number", "minimum": 0},
        "worker_startup_ms": {"type": ["number", "null"], "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0},
        "peak_cpu_percent": {"type": "number", "minimum": 0},
        "peak_process_count": {"type": "integer", "minimum": 1}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ids", "evidence"],
      "properties": {
        "fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fact_id", "ref", "path", "start_line", "end_line", "quote"],
            "properties": {
              "fact_id": {"type": "string"}, "ref": {"type": "string"}, "path": {"type": "string"},
              "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string"}
            }
          }
        }
      }
    },
    "raw": {
      "type": "object", "additionalProperties": false,
      "required": ["responses", "final_output_text", "sha256"],
      "properties": {
        "responses": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "final_output_text": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "grading": {
      "type": "object", "additionalProperties": false,
      "required": ["grader_version", "grader_sha256", "claim_mapping"],
      "properties": {
        "grader_version": {"type": "string"},
        "grader_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim_mapping": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim_index", "claim_sha256_input", "fact_id", "method"],
            "properties": {
              "claim_index": {"type": "integer", "minimum": 0},
              "claim_sha256_input": {"type": "string"},
              "fact_id": {"type": ["string", "null"]},
              "method": {"const": "normalized_exact_v1"}
            }
          }
        }
      }
    }
  }
}
