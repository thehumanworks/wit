{
  "name": "@nothumanwork/wit-sdk",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the wit URL API (read GitHub repositories without cloning).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehumanworks/wit.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://wit.thehuman.sh/api/llms.txt",
  "bugs": {
    "url": "https://github.com/thehumanworks/wit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "github",
    "agents",
    "wit",
    "code-search",
    "llm"
  ]
}
